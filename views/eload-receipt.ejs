<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eload Receipt — <%= wifiName %></title>
  <link rel="stylesheet" href="/css/portal.css">
  <style>
    .receipt-card {
      background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15);
      border-radius:16px; padding:28px 24px; text-align:center; margin-bottom:20px;
    }
    .receipt-icon { font-size:3rem; margin-bottom:12px; }
    .receipt-status { font-size:1.1rem; font-weight:700; margin-bottom:20px; }
    .receipt-status.success { color:#22c55e; }
    .receipt-status.pending { color:#f7c948; }
    .receipt-row {
      display:flex; justify-content:space-between;
      padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.08);
      font-size:.9rem;
    }
    .receipt-row:last-child { border-bottom:none; }
    .receipt-row .label { color:rgba(255,255,255,0.5); }
    .receipt-row .value { color:#fff; font-weight:600; }
    .receipt-amount { font-size:2.2rem; font-weight:700; color:#f7c948; margin:12px 0; }
    .ref-code { font-size:1.1rem; color:#93c5fd; font-family:monospace; letter-spacing:2px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="receipt-card">
      <% if (order.status === 'completed') { %>
        <div class="receipt-icon">✅</div>
        <div class="receipt-status success">Eload Sent!</div>
      <% } else { %>
        <div class="receipt-icon">⏳</div>
        <div class="receipt-status pending">Order Received — Processing</div>
      <% } %>

      <div class="receipt-amount">₱<%= order.amount %></div>
      <div style="color:rgba(255,255,255,0.5);font-size:.85rem;margin-bottom:16px">
        <%= order.network %> Eload
      </div>

      <div class="receipt-row">
        <span class="label">Phone Number</span>
        <span class="value"><%= order.phone %></span>
      </div>
      <div class="receipt-row">
        <span class="label">Network</span>
        <span class="value"><%= order.network %></span>
      </div>
      <div class="receipt-row">
        <span class="label">Product</span>
        <span class="value"><%= order.product_name %></span>
      </div>
      <div class="receipt-row">
        <span class="label">Reference #</span>
        <span class="value ref-code">#<%= String(order.id).padStart(6,'0') %></span>
      </div>
      <div class="receipt-row">
        <span class="label">Date/Time</span>
        <span class="value"><%= new Date(order.created_at * 1000).toLocaleString('en-PH') %></span>
      </div>
    </div>

    <% if (order.status === 'pending') { %>
      <div class="alert success" style="text-align:center">
        📲 The operator will send your eload shortly.<br>
        Keep this reference number: <strong>#<%= String(order.id).padStart(6,'0') %></strong>
      </div>
    <% } %>

    <a href="/portal" class="btn-pay" style="display:block;text-align:center;text-decoration:none;margin-top:12px">
      ← Back to WiFi Portal
    </a>
    <a href="/eload" class="btn-pay" style="display:block;text-align:center;text-decoration:none;
       margin-top:8px;background:rgba(255,255,255,0.1);color:#fff">
      Buy More Eload
    </a>
  </div>
</body>
</html>
