<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — Piso WiFi</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-layout">
  <%- include('_nav') %>
  <main>
    <h2>🔧 Settings</h2>
    <% if (message) { %><div class="alert success"><%= message %></div><% } %>

    <div class="card-row">
      <div class="card">
        <h3>General Settings</h3>
        <form action="/admin/settings" method="POST">
          <div class="form-group">
            <label>WiFi Name (SSID displayed on portal)</label>
            <input type="text" name="wifi_name" value="<%= settings.wifi_name || '' %>" required>
          </div>
          <div class="form-group">
            <label>Machine Name</label>
            <input type="text" name="machine_name" value="<%= settings.machine_name || '' %>">
          </div>
          <div class="form-group">
            <label>Idle Timeout (minutes)</label>
            <input type="number" name="idle_timeout_min" min="1" value="<%= settings.idle_timeout_min || 5 %>">
          </div>
          <button type="submit" class="btn-primary">Save Settings</button>
        </form>
      </div>

      <div class="card">
        <h3>Change Admin Password</h3>
        <form action="/admin/change-password" method="POST">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="current" required>
          </div>
          <div class="form-group">
            <label>New Password</label>
            <input type="password" name="newpass" required minlength="6">
          </div>
          <div class="form-group">
            <label>Confirm New Password</label>
            <input type="password" name="confirm" required minlength="6">
          </div>
          <button type="submit" class="btn-danger">Change Password</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
