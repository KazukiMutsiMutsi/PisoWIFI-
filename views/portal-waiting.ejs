<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Insert Coin — <%= wifiName %></title>
  <!-- Auto-refresh every 3 seconds to check if coin was inserted -->
  <meta http-equiv="refresh" content="3;url=/portal/waiting">
  <link rel="stylesheet" href="/css/portal.css">
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="hero-text"><span class="hero-tagline"><%= wifiName %></span></div>
  </div>

  <div class="portal-card">

    <!-- 30-second countdown -->
    <div style="text-align:center;margin-bottom:16px">
      <p style="font-size:.72rem;color:#6b7280;letter-spacing:2px;
                text-transform:uppercase;margin-bottom:6px">DROP COIN WITHIN</p>
      <div id="cdown" style="font-family:'Orbitron',monospace;font-size:5rem;
                font-weight:900;color:#f7c948;line-height:1;
                text-shadow:0 0 24px rgba(247,201,72,0.7)">30</div>
      <p style="font-size:.7rem;color:#6b7280;letter-spacing:2px;margin-top:4px">SECONDS</p>
    </div>

    <div class="time-bar-track" style="margin-bottom:20px">
      <div id="cbar" class="time-bar-fill"
           style="background:#f7c948;box-shadow:0 0 8px rgba(247,201,72,0.6)"></div>
    </div>

    <!-- Rates -->
    <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);
                border-radius:12px;padding:14px 16px;margin-bottom:16px">
      <p style="font-size:.72rem;color:#6b7280;letter-spacing:2px;text-transform:uppercase;
                text-align:center;margin-bottom:10px">💰 RATES</p>
      <% rates.forEach(rate => { %>
        <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:7px 10px;border-radius:8px;margin-bottom:4px;
                    background:rgba(255,255,255,0.03)">
          <span style="font-family:'Orbitron',monospace;font-size:1rem;
                       font-weight:700;color:#f87171">₱<%= rate.coins %></span>
          <span style="color:rgba(255,255,255,0.3);font-size:.8rem">→</span>
          <span style="font-weight:700;color:#22c55e;font-size:.9rem">
            <%= rate.minutes < 60
              ? rate.minutes + ' mins'
              : (rate.minutes === 1440 ? '24 hrs (Full Day)'
                : Math.floor(rate.minutes/60) + (rate.minutes%60>0 ? ' hr ' + rate.minutes%60 + ' min' : ' hr' + (Math.floor(rate.minutes/60)>1?'s':''))) %>
          </span>
        </div>
      <% }) %>
    </div>

    <!-- Status -->
    <div style="display:flex;align-items:center;justify-content:center;gap:10px;
         color:rgba(255,255,255,0.4);font-size:.85rem;margin-bottom:20px">
      <span style="width:9px;height:9px;background:#22c55e;border-radius:50%;
            display:inline-block;animation:pulse-timer .8s ease-in-out infinite"></span>
      Waiting for coin...
    </div>

    <a href="/portal"
       style="display:block;width:100%;text-align:center;padding:13px;
              background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);
              border-radius:10px;color:rgba(255,255,255,0.5);text-decoration:none;
              font-family:'Rajdhani',sans-serif;font-weight:600;font-size:.95rem;
              letter-spacing:1px">
      ✕ Cancel
    </a>

    <div class="portal-footer" style="margin-top:16px">
      Powered by: <strong><%= wifiName %></strong>
    </div>
  </div>

  <script>
  // ══════════════════════════════════════════════════
  //  AUDIO
  // ══════════════════════════════════════════════════
  let _ctx = null;
  function audio() {
    if (!_ctx) _ctx = new (window.AudioContext || window.webkitAudioContext)();
    return _ctx;
  }
  document.addEventListener('click',      () => audio(), { once: false });
  document.addEventListener('touchstart', () => audio(), { once: false });

  function beep(freq, dur, vol, type, delay) {
    try {
      const c=audio(), t=c.currentTime+(delay||0)/1000;
      const o=c.createOscillator(), g=c.createGain();
      o.connect(g); g.connect(c.destination);
      o.type=type||'sine'; o.frequency.value=freq;
      g.gain.setValueAtTime(vol,t);
      g.gain.exponentialRampToValueAtTime(0.001,t+dur/1000);
      o.start(t); o.stop(t+dur/1000+0.05);
    } catch(e){}
  }

  function sndTick()    { beep(880, 60, 0.25, 'square', 0); }
  function sndUrgent()  { beep(660,100, 0.4,  'square', 0); beep(440,150,0.4,'square',120); }
  function sndTimeout() { beep(330,300, 0.5, 'sawtooth',0); beep(220,500,0.5,'sawtooth',360); }

  // ══════════════════════════════════════════════════
  //  30-SECOND COUNTDOWN
  //  Uses sessionStorage to persist countdown across
  //  the 3-second meta-refresh cycles.
  // ══════════════════════════════════════════════════

  const START_KEY = 'waitStart';

  // Record when this waiting session started
  if (!sessionStorage.getItem(START_KEY)) {
    sessionStorage.setItem(START_KEY, Date.now().toString());
  }

  const startTime = parseInt(sessionStorage.getItem(START_KEY));
  const elapsed   = Math.floor((Date.now() - startTime) / 1000);
  let remaining   = Math.max(0, 30 - elapsed);

  function updateDisplay() {
    const el  = document.getElementById('cdown');
    const bar = document.getElementById('cbar');
    if (el)  el.textContent   = remaining;
    if (bar) {
      bar.style.width      = (remaining / 30 * 100) + '%';
      bar.style.background = remaining > 15 ? '#f7c948'
                           : remaining > 5  ? '#f97316'
                           :                   '#ef4444';
      bar.style.boxShadow  = remaining > 15
        ? '0 0 8px rgba(247,201,72,0.6)'
        : remaining > 5
        ? '0 0 8px rgba(249,115,22,0.6)'
        : '0 0 8px rgba(239,68,68,0.6)';
    }
  }

  // If time already ran out when page loaded (after a refresh cycle)
  if (remaining <= 0) {
    sessionStorage.removeItem(START_KEY);
    sndTimeout();
    window.location.href = '/portal';
  } else {
    updateDisplay();

    // Count down every second with sound
    let s = remaining;
    const iv = setInterval(() => {
      s--;
      remaining = s;
      updateDisplay();

      if (s <= 10 && s > 0) sndTick();
      if (s <= 5  && s > 0) sndUrgent();

      if (s <= 0) {
        clearInterval(iv);
        sessionStorage.removeItem(START_KEY);
        sndTimeout();
        // Let meta-refresh handle the redirect
      }
    }, 1000);
  }

  // Clean up sessionStorage when Cancel is clicked
  document.querySelector('a[href="/portal"]').addEventListener('click', () => {
    sessionStorage.removeItem(START_KEY);
  });
  </script>
</body>
</html>
